/* TUI layout for odoodev Odoo server runtime */

Screen {
    layout: vertical;
}

#status-bar {
    height: 1;
    dock: top;
    background: $primary-background;
}

/* FilterBar styles are defined in filter_bar.py DEFAULT_CSS */

#log-viewer {
    height: 1fr;
}

#log-output {
    height: 1fr;
    scrollbar-size: 1 1;
    /* Border reserved (background-coloured = invisible) so toggling the accent
       mark-mode border below adds no layout reflow. */
    border: round $background;
}

/* Selection (mark) mode active — accent border frames the log so the mode is
   obvious at a glance, alongside the status-bar MARK badge. */
#log-output.mark-mode {
    border: round $accent;
}

/* Mouse text selection in the log — opaque and high-contrast so the marked
   region is unmistakable. Textual's default (.screen--selection: $primary 50%)
   is semi-transparent and barely visible on the dark log background. Kept
   distinct from the search highlight (bold reverse green in log_viewer.py). */
.screen--selection {
    background: $accent;
    color: $text;
}

Footer {
    dock: bottom;
}

/* odoodev version on its own thin row just above the footer.
   NOT docked — a second dock:bottom widget overlaps the Footer on the same
   row. As a normal flow row (after the 1fr log viewer) it sits right above
   the docked footer without covering it. */
#app-version {
    height: 1;
    width: 100%;
    text-align: right;
    color: $text-muted;
    padding: 0 1;
}
