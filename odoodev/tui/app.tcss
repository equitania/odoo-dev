/* TUI layout for odoodev Odoo server runtime */

Screen {
    layout: vertical;
    layers: base overlay;
}

#status-bar {
    height: 1;
    dock: top;
    background: $primary-background;
}

/* FilterBar styles are defined in filter_bar.py DEFAULT_CSS */

#log-viewer {
    height: 1fr;
}

#log-output {
    height: 1fr;
    scrollbar-size: 1 1;
}

Footer {
    dock: bottom;
}

/* odoodev version, overlaid on the right of the footer row */
#app-version {
    layer: overlay;
    dock: bottom;
    height: 1;
    width: 100%;
    text-align: right;
    color: $text-muted;
    background: transparent;
    padding: 0 1;
}
