/* Layout for the user-management TUI (odoodev db users) */

Screen {
    layout: vertical;
}

#users-title {
    height: 1;
    padding: 0 1;
    background: $primary-darken-2;
    color: $text;
}

#users-search {
    height: 3;
    margin: 0 1;
}

#users-table {
    height: 1fr;
    margin: 0 1;
}

#users-status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
